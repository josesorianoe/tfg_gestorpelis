# Copia este archivo a docker-compose.override.yml para personalizaciones locales
# Este archivo NUNCA se commitea al repositorio
#
# Ejemplo: habilitar Xdebug en desarrollo

services:
  app:
    environment:
      - XDEBUG_MODE=debug
      - XDEBUG_CONFIG=client_host=host-gateway
    # ports:
    #   - "9003:9003"  # Xdebug port
