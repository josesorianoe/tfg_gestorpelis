# ================================================================
# CodeIgniter 4 - Gestor Películas API
# Copia este archivo a .env y rellena los valores
# ================================================================

# ---------------------------------------------------------------
# CodeIgniter
# ---------------------------------------------------------------
CI_ENVIRONMENT=development
app.baseURL=http://localhost:8080/
# Genera con: php -r "echo bin2hex(random_bytes(32));"
encryption.key=

# ---------------------------------------------------------------
# Base de datos (debe coincidir con los valores de PostgreSQL)
# ---------------------------------------------------------------
database.default.hostname=db
database.default.database=movies_db
database.default.username=movies_user
database.default.password=movies_pass
database.default.DBDriver=Postgre
database.default.port=5432

# ---------------------------------------------------------------
# PostgreSQL (para docker-compose)
# ---------------------------------------------------------------
POSTGRES_DB=movies_db
POSTGRES_USER=movies_user
POSTGRES_PASSWORD=movies_pass
POSTGRES_PORT=5432

# ---------------------------------------------------------------
# pgAdmin
# ---------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ---------------------------------------------------------------
# Nginx
# ---------------------------------------------------------------
NGINX_PORT=8080

# ---------------------------------------------------------------
# Docker user (evita problemas de permisos en Linux)
# Ejecuta `id -u` e `id -g` para obtener tus valores
# ---------------------------------------------------------------
UID=1000
GID=1000

# ---------------------------------------------------------------
# TMDB API
# Obtén tu API key en: https://www.themoviedb.org/settings/api
# ---------------------------------------------------------------
TMDB_API_KEY=tu_api_key_aqui
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_CACHE_TTL=86400

# ---------------------------------------------------------------
# JWT
# Genera con: php -r "echo bin2hex(random_bytes(64));"
# ---------------------------------------------------------------
JWT_SECRET=genera_un_string_aleatorio_largo_aqui_minimo_64_chars
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
